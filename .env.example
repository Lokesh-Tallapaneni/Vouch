# Copy to .env and fill in. Never commit .env.
# The URI and password come from the CognoDB Cloud console when you create
# a free (c0) instance. The password is shown exactly once.

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Signing key for the identity token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional — defaults shown
LOG_LEVEL=INFO
QUERY_TIMEOUT_S=10
